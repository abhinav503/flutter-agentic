NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-side, service account) — used by cart/order routes.
# FIREBASE_ADMIN_PRIVATE_KEY must stay double-quoted with real newlines preserved
# (dotenv's multi-line-quoted-value format) — do not collapse it to one line.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# AES-256-GCM key for encrypting stored secrets (Razorpay key secrets).
# 64 hex chars = 32 bytes. Generate: openssl rand -hex 32
PAYMENTS_ENC_KEY=

# Ola Maps (maps.olakrutrim.com) API key — powers the /api/geo/* proxy
# routes (reverse geocode + address autocomplete for the shopper address
# form). Free tier: 5M calls/month per API. Server-side only.
OLA_MAPS_API_KEY=

# TODO (not set yet — the weekly device prune stays disabled until it is).
# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`
# when it calls /api/devices/prune. Unset means the cron door is closed and
# the endpoint is superadmin-only, which is the safe default: an open prune
# endpoint deletes every shopper's device registrations.
# Generate: openssl rand -hex 32
CRON_SECRET=

# Firebase App Check for the console (optional). A reCAPTCHA Enterprise site
# key from Google Cloud → Security → reCAPTCHA Enterprise, registered under
# Firebase → App Check → the web app. Leave unset to skip App Check locally.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
