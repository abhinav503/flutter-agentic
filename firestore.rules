rules_version = '2';

// Multi-tenant rules for the FlutterAgenticEcommerce platform.
// Schema: docs/explanation/superapp-ecommerce-plan.md
//
// Store-write authority is ownerUid-based for now. A `storeIds` custom
// claim exists (stamped by the admin console's POST /api/stores; trusted by
// the REST API's requireStoreOwner) but is not yet read here — a `role:
// storeAdmin` claim ships in a later milestone; tighten to
// `request.auth.token.role == 'storeAdmin'` once it exists.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStoreOwner(storeId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;
    }

    // CordeliaApps staff, for the handful of surfaces that address every
    // store at once. Read off the custom claim rather than the admins doc so
    // it costs no document read and cannot be granted by any client write —
    // only admin/scripts/grant-superadmin.mjs (Admin SDK) can set it. The
    // console's `isSuperAdmin` flag reads the mirrored `admins/{uid}.role`
    // field for rendering; this is the authority.
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.role == 'superAdmin';
    }

    // Shopper profile — created on gravia sign-up.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /carts/{storeId} {
        allow read, write: if isOwner(uid);
      }

      // Read receipts, doc id = the notification's id. Server-only, unlike
      // the cart above: the same token-verified API call that serves the feed
      // marks it read, so letting the client write here would give a
      // server-owned value a second source of truth.
      match /notificationReads/{notificationId} {
        allow read, write: if false;
      }

      // This shopper's own notifications — order updates, addressed to them
      // rather than broadcast. Written only by the server (lib/push.ts) and
      // served through the notifications API, which is also what merges them
      // with the store and platform feeds. Not even the owner writes here:
      // a shopper who could author their own "order delivered" could forge
      // one.
      match /notifications/{notificationId} {
        allow read, write: if false;
      }
    }

    // Store-owner record — created on admin-console sign-up with an empty
    // storeIds list; from then on the doc is server-maintained (the admin
    // console's POST /api/stores appends storeIds via the Admin SDK and
    // stamps the matching `storeIds` custom claim). Client updates are
    // forbidden so a signed-in admin can't grant itself another store —
    // the claim, not this doc, is what the REST API's requireStoreOwner
    // trusts. Clients only read it (dashboard StoreProvider onSnapshot).
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.storeIds.size() == 0;
      allow update, delete: if false;
    }

    // Store catalog — world-readable for shopper discovery/browsing;
    // creation is server-only (POST /api/stores, Admin SDK bypasses rules)
    // so ownership and the storeIds claim always move together; other
    // writes restricted to the store's own owner.
    match /stores/{storeId} {
      allow read: if true;
      allow create: if false;
      allow update, delete: if isStoreOwner(storeId);

      // Server-only secrets (Razorpay key id + encrypted secret). The store
      // doc above is world-readable and Firestore reads are per-document, so
      // these must live in their own doc that no client can read — the admin
      // console's payment-config API reaches them via the Admin SDK, which
      // bypasses rules.
      match /private/{doc} {
        allow read, write: if false;
      }

      match /categories/{categoryId} {
        allow read: if true;
        allow write: if isStoreOwner(storeId);
      }

      match /products/{productId} {
        allow read: if true;
        allow write: if isStoreOwner(storeId);

        // Product reviews, doc id = the reviewer's uid. World-readable like
        // the product they hang off — a rating is part of a product's public
        // face. Writes are server-only (the token-verified reviews API,
        // Admin SDK) even for the review's own author: every write also
        // moves the product doc's ratingAverage/reviewCount/ratingBuckets in
        // the same transaction, and a client-SDK write would leave the two
        // to drift. Same posture as coupons/redemptions.
        match /reviews/{uid} {
          allow read: if true;
          allow write: if false;
        }
      }

      // Promo banners for the storefront's home carousel — same gate as the
      // catalog above. World-readable includes banners the owner has
      // unchecked ("Show in carousel"); hiding one is merchandising, not
      // access control, and the banners API is what enforces it.
      match /banners/{bannerId} {
        allow read: if true;
        allow write: if isStoreOwner(storeId);
      }

      // Product brands ("Amul", "Tata") products reference by id — same
      // gate as the catalog above.
      match /brands/{brandId} {
        allow read: if true;
        allow write: if isStoreOwner(storeId);
      }

      // In-app notifications this store sends its own shoppers. Not
      // world-readable and not client-readable at all: shoppers receive them
      // through GET /api/stores/{id}/notifications, which merges this feed
      // with the platform one and stamps each shopper's read state — a
      // client-SDK read would return neither. The owner reads its own list to
      // manage it, which `isStoreOwner` already covers.
      match /notifications/{notificationId} {
        allow read, write: if isStoreOwner(storeId);
      }

      // Discount codes — owner-only, NOT world-readable like the catalog:
      // shoppers validate a code through the token-verified API, so the
      // codes themselves never need to be listable client-side.
      match /coupons/{couponId} {
        allow read, write: if isStoreOwner(storeId);

        // Per-shopper redemption counts, written only inside the order
        // transaction via the Admin SDK (which bypasses rules).
        match /redemptions/{uid} {
          allow read, write: if false;
        }
      }
    }

    // Storefront template catalog — world-readable so the create-store
    // dialog's template dropdown can list them; seeded only via the Admin
    // SDK (scripts/seed-templates.mjs), never client-writable.
    match /templates/{templateId} {
      allow read: if true;
      allow write: if false;
    }

    // Platform-wide notifications from CordeliaApps, shown in every store's
    // app alongside that store's own. Superadmin-only, and a separate
    // collection from the per-store one precisely so authority is a path: a
    // store owner has no rule that could ever reach this one. Shoppers read
    // it through the notifications API (Admin SDK), never directly.
    match /notifications/{notificationId} {
      allow read, write: if isSuperAdmin();
    }

    // Registered FCM device tokens, keyed by the token itself with the owning
    // uid as a field (see admin/src/lib/devices.ts — a handset can then only
    // ever belong to one account). Top-level rather than under `users/{uid}`
    // for that reason, which also means this rule is the only thing standing
    // between a client and someone else's device: server-only, written by the
    // token-verified /api/users/devices route. A client that could write here
    // could file its token under another account and start receiving that
    // shopper's order updates.
    match /devices/{token} {
      allow read, write: if false;
    }

    // Orders — a shopper creates/reads their own; the owning store can read
    // (and later advance status). No client-side price trust beyond create.
    match /orders/{orderId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() &&
        (resource.data.uid == request.auth.uid || isStoreOwner(resource.data.storeId));
      allow update: if isStoreOwner(resource.data.storeId);
      allow delete: if false;
    }
  }
}
